# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL + PostGIS)
DB_NAME=pmp_db
DB_USER=pmp_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS / Frontend
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180

# Channels / Redis (leave REDIS_URL empty to use in-memory layer for local dev)
REDIS_URL=

# GeoDjango native libraries (Windows only - point to your PostgreSQL/PostGIS bin folder)
GDAL_LIBRARY_PATH=C:/Program Files/PostgreSQL/16/bin/libgdal-34.dll
GEOS_LIBRARY_PATH=C:/Program Files/PostgreSQL/16/bin/libgeos_c.dll

# JWT
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7
